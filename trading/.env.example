# Trading system (paper trading + real market data)
# Copy relevant keys into your deployment env — never commit real secrets.

# --- Market data ---
# Crypto uses Coinbase Exchange public API (no key).
# Stocks: Finnhub free key for live quotes (required).
# Candles use Yahoo chart API automatically when Finnhub candle access is denied.
# Get a key at https://finnhub.io/
FINNHUB_API_KEY=

# How often to poll external market APIs (engine reads cache in between).
CRYPTO_POLL_INTERVAL_SECONDS=30
STOCK_POLL_INTERVAL_SECONDS=60
TRADING_STALE_AFTER_SECONDS=120
TRADING_CHART_TIMEFRAME=5m

# Offline/unit-test only — do NOT enable in production.
# TRADING_USE_SIMULATED_FEED=false

# --- AI Market Analyst (OpenAI) ---
AI_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AI_MIN_INTERVAL_SECONDS=90
AI_MAX_CALLS_PER_HOUR=20
AI_PRICE_TRIGGER_PERCENT=0.35
AI_AGENT_WEIGHT=1.0
AI_CACHE_TTL_SECONDS=180

# Existing trading knobs
# TRADING_BASE_PATH=/trading
# TRADING_TICK_INTERVAL_SEC=2
# TRADING_FILL_COOLDOWN_SEC=45
# TRADING_DECISION_LOG_LIMIT=200
# TRADING_STARTING_CASH=100000
# TRADING_SYMBOLS=BTC-USD,ETH-USD,SOL-USD,AAPL,NVDA
